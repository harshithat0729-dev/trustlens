# ---- Backend settings (copy to backend/.env and fill) ----
# Never commit the real .env file.

# CORS: comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Max upload size in MB
MAX_UPLOAD_MB=15

# Optional LLM for explanation. Leave blank to use the rule-based explainer.
LLM_API_KEY=
LLM_API_URL=

# Optional: Tesseract binary path (usually auto-detected)
TESSERACT_CMD=
